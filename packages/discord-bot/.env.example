# === REQUIRED ===

# Discord Bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token

# === Persona ===

# Which persona this bot instance acts as. Must match a persona `name` defined
# in persona.config.json (copy from persona.config.example.json; gitignored).
# The config path can also be overridden via RHI_PERSONA_CONFIG.
# Leave unset/empty to disable the persona pipeline (generic-Claude only).
# BOT_PERSONA=
# RHI_PERSONA_CONFIG=/abs/path/to/persona.config.json

# Other AI bot user IDs treated as "peer bots" (allowed past the `bot` filter).
# Comma-separated. Each bot's .env lists the OTHER bot's user ID.
# PEER_BOT_IDS=

# Cost-fuse: persona session is killed once turnCount reaches this in one
# conversation. Resets on kill/clear/idle-evict. Default 40.
# MAX_AI_TURNS_PER_CONVERSATION=40

# When 0, disables the persona Discord pipeline on this instance. Default 1.
# PERSONA_DISCORD=1

# === Claude CLI ===

# By default the bot auto-resolves the `claude` shim on PATH (parses the .cmd
# on Windows to find bin/claude.exe, with fallback to cli-wrapper.cjs / cli.js).
# Leave these blank for auto-detection.
# CLAUDE_CLI_PATH=claude
# CLAUDE_CLI_SCRIPT=
# CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_SUBPROCESS_TIMEOUT_MS=1800000
# USE_AGENT_SDK=false

# === Sessions / Permissions ===

SESSION_IDLE_TIMEOUT_MS=1800000
MAX_CONCURRENT_SESSIONS=5
PERMISSION_MODE=auto

# Colon-separated list of dirs Claude is allowed to use as working dir.
# Also gates the path-traversal guard for discord_send_message files[] over HTTP MCP.
ALLOWED_WORKING_DIRS=.

# Comma-separated Discord user IDs. Empty = all users allowed.
# Note: this allowlist applies only to the Discord message path; the HTTP MCP
# surface is gated only by MCP_API_KEY (see Security Runbook in README).
ALLOWED_USER_IDS=your_discord_user_id

# Working directory for Claude CLI subprocess
DEFAULT_WORKING_DIR=.

# === MCP HTTP Server (Sprint 1, feature-flagged off by default) ===

# Master switch. When false (default), the HTTP MCP transport is dormant and
# the daemon behaves exactly as before this feature shipped.
# Flip to true alongside dogfood + key rotation (see README Security Runbook).
MCP_HTTP_ENABLE=false

# Listen port. Default 7800.
MCP_HTTP_PORT=7800

# Bind address. DEFAULT is 127.0.0.1 (loopback only). Setting this to 0.0.0.0
# exposes the daemon over the LAN — read the
# "MCP_BIND=0.0.0.0 への flip — LAN expose 操作手順" section of README (Security
# Runbook) before changing. Always dry-run with
#   node scripts/smoke-http-mcp-w2-s4.mjs
# (loopback, ephemeral port) before flipping in production.
MCP_BIND=127.0.0.1

# Shared bearer token for `Authorization: Bearer …`. REQUIRED when
# MCP_HTTP_ENABLE=true (daemon will exit on boot if missing). NEVER commit.
# Generate with: openssl rand -hex 32
MCP_API_KEY=

# DNS-rebinding defense. The HTTP server only accepts requests whose Host
# header is one of these. Host values are normalised before comparison:
# lowercased, trailing dot stripped, IPv6 bracket unwrapped; comma/whitespace
# Host values are rejected as header-smuggling attempts.
# Add LAN IP/hostname when flipping MCP_BIND=0.0.0.0
#   e.g. MCP_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50,myhost.local
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated tool names that are NOT exposed over HTTP (stdio unaffected).
# Defaults block LAN-RCE-grade tools. New tools default to "HTTP-denied" until
# explicitly removed from this list — review the threat model before opening any.
MCP_HTTP_TOOL_DENYLIST=browser_eval,browser_open,browser_fill,gemini_review,gemini_search

# Comma-separated guild IDs the bot is allowed to act on. Empty = all guilds.
# MCP_ALLOWED_GUILD_IDS=

# === Swarm ===

# SWARM_REPORT_CHANNEL_ID=your_swarm_report_channel_id
# SWARM_GUILD_ID=your_swarm_guild_id
# SWARM_MAX_WORKERS=7

# === Setup scripts (scripts/) ===

# Used by scripts/setup-channels.ts, setup-webhooks.ts, test-rest.ts to target
# your server. Channel/user IDs in those scripts are placeholder constants you
# edit in-file; these two are read from env.
# GUILD_ID=your_guild_id
# BOT_ID=your_bot_application_id
# TEST_CHANNEL_ID=your_test_channel_id

# === External CLIs / Tools ===

# Chrome executable path (auto-detected by platform if not set)
# CHROME_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Chrome sandbox mode (set true if running as root on Linux)
# CHROME_NO_SANDBOX=false

# agent-browser CLI
# AGENT_BROWSER_PATH=agent-browser
# AGENT_BROWSER_TIMEOUT_MS=30000

# Gemini CLI delegation
# GEMINI_CLI_PATH=gemini
# GEMINI_MODEL=gemini-3.1-pro-preview
# GEMINI_TIMEOUT_MS=120000

# DNS servers used by the bot (comma-separated, applied by src/dns-fix.ts)
# DNS_SERVERS=8.8.8.8,8.8.4.4

# === Invoice / Mail ===

# Invoice PDF output directory (required for invoice generation)
# INVOICE_OUTPUT_DIR=
# Fumoar Excel template path (required for Fumoar invoices)
# FUMOAR_TEMPLATE_PATH=
# Novel project path (for 小説 channel)
# NOVEL_PROJECT_PATH=

# Mailgun (for invoice email)
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.example.com

# Invoice sender identity (used in the email From name, body and signature).
# INVOICE_SENDER_NAME=
# INVOICE_SENDER_CONTACT=
# INVOICE_SENDER_EMAIL=

# === Notion ===

# Notion Internal Integration Token (used by /task command and persona schema cache)
# NOTION_API_KEY=

# Discord channel ID of your accounting channel. When set, the protected_rows
# section (config/protected-rows.json) is appended to that channel's system prompt.
# Optional — leave unset to disable.
# ACCOUNTING_CHANNEL_ID=

# === Logging / OpenRouter ===

# Structured log level (DEBUG, INFO, WARN, ERROR)
# LOG_LEVEL=INFO

# Discord webhook URL for scheduled-task failure notifications
# DISCORD_WEBHOOK_ERROR_URL=

# OpenRouter / Anthropic base URL overrides (for model switching experiments)
# OPENROUTER_API_KEY=
# ANTHROPIC_BASE_URL=
