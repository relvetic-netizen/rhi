{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src", "../extracted/screening", "../extracted/memory", "../extracted/evals", "../extracted/tools/MemorySearchTool.ts", "../extracted/util"],
  "exclude": ["node_modules", "dist", "test"]
}
