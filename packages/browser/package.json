{
  "name": "relvetia-browser",
  "version": "0.1.0",
  "description": "Domain-skill-aware CDP browser helper for Relvetia",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "relvetia-browser": "dist/cli.js"
  },
  "scripts": {
